# Copy to .env (git-ignored) or export in your shell. Never commit the real values.
RUNPOD_API_KEY=
# Optional: only for gated Hugging Face repos during provisioning (set on the pod).
HF_TOKEN=
# Optional: where the Claude Code skill finds this checkout.
REMOTE_COMFY_HOME=
# Optional: keyring lookup used when RUNPOD_API_KEY is unset.
REMOTE_COMFY_KEYRING_SERVICE=remote-comfy
REMOTE_COMFY_KEYRING_USER=runpod
